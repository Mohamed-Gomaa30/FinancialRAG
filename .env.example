# Copy to .env and adjust. Never commit .env.

# --- File validation and storage ----------------------------------
FILE_TYPE=["application/pdf"]
MAX_FILE_SIZE=104857600          # bytes (100 MB)
DATA_DIR=data                    # raw/ and parsed/ live under this
CHUNK_SIZE=65536                 # upload read size in bytes

# --- Postgres (read by docker-compose) ----------------------------
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag
POSTGRES_PORT=5432

# --- Redis (read by docker-compose) -------------------------------
REDIS_PORT=6379

# --- Connection URLs (read by the app) ----------------------------
# Must match the POSTGRES_* values above.
# Use host "localhost" when the api runs on your machine,
# and "postgres" / "redis" when it runs inside docker compose.
DATABASE_URL=postgresql+psycopg://rag:change-me@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0

# --- Later phases --------------------------------------------------
# GEMINI_API_KEY=
# HUGGINGFACE_TOKEN=
